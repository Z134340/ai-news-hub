{
  "schema": "hermes-project-optimization-profile/v1",
  "project_id": "ai-news-hub",
  "root": "/Users/zyc/ai-news-hub",
  "runtime_identity": {
    "source": "git_head",
    "required_fields": ["git_sha", "worktree_digest"]
  },
  "managed_targets": {
    "allowlist": ["README.md", "docs/**/*.md", ".hermes/skills/*/metadata.json"],
    "forbidden": [
      ".git/**",
      ".env*",
      "**/credentials/**",
      "**/secrets/**",
      "AGENTS.md",
      "CLAUDE.md",
      "HANDOFF.md",
      "SKILL.md",
      "FIREBASE-SETUP.md",
      "ARCHIVE-SETUP.md",
      "OPS-RUNBOOK.md",
      "hermes.project.yaml",
      ".github/**",
      "assets/**",
      "scripts/**",
      "data/**",
      "agents/**",
      "firebase.json",
      "firestore.rules"
    ]
  },
  "tests": [
    {
      "id": "agent-output-boundary",
      "argv": ["node", "scripts/agent/check-agent-outputs.mjs", "--strict", "--self-test-boundary"]
    },
    {
      "id": "diff-check",
      "argv": ["git", "diff", "--check"]
    }
  ],
  "success_metrics": [
    "agent output boundary self-test passes",
    "candidate introduces no Git whitespace errors",
    "no public data, deployment, scheduler, or agent charter target is modified"
  ],
  "canary": {
    "strategy": "isolated_worktree",
    "requires_isolated_git_worktree": true
  },
  "rollback": {
    "strategy": "content_addressed_preimage",
    "exact_previous_revision": true
  },
  "data_sensitivity": "internal",
  "owner": {
    "id": "ZY",
    "iris_owner_gate_for_manual_items": true
  },
  "manual_only": true,
  "execution": {
    "allowed_models": ["gpt-5.5", "claude-opus-5"],
    "allowed_tools": ["filesystem_read", "git_read", "local_test"],
    "max_parallelism": 1
  },
  "automation": {
    "mode": "shadow_only",
    "allowed_change_types": ["documentation", "skill_metadata"]
  }
}
