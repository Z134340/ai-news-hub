{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news-item.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "type": "object",
      "required": [
        "title",
        "date",
        "summary"
      ],
      "properties": {
        "authors": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 1
            }
          ]
        },
        "stars": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "authors"
          ]
        }
      ]
    }
  ]
}
